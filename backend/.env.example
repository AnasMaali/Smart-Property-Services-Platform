# Production MUST set APP_ENV=production and APP_DEBUG=false - local
# development values only. See bootstrap/app.php: Laravel's own defaults
# (env unset -> "production", debug unset -> false) are already the safe
# direction if either is accidentally left out of a real deployment's env.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated reverse proxy/load balancer IP(s)/CIDR(s) that terminate
# real client connections in front of this app (e.g. Nginx, an internal
# load balancer). Left unset (the safe default), no proxy is trusted and
# X-Forwarded-For is ignored entirely, so $request->ip() - used throughout
# rate limiting (App\Providers\AppServiceProvider) and Admin audit logging
# (App\Support\Admin\AdminAuditLogger) - is always the real, unspoofable
# TCP peer address. Set this only when actually deployed behind such a
# proxy, to the proxy's own address(es), never a client-facing value. "*"
# is supported only for a deployment with no stable proxy IP to pin to
# (e.g. some CDNs) - prefer explicit IPs/CIDRs whenever possible.
TRUSTED_PROXIES=

# Comma-separated browser-facing origins allowed to call this API
# cross-origin (config/cors.php) - only relevant to the Admin Web frontend
# and any other browser-based client; the Flutter mobile app is never
# subject to browser CORS. Left unset, every origin is allowed ("*"),
# matching local development convenience. Production should restrict this
# to the real Admin Web origin(s), e.g.
# CORS_ALLOWED_ORIGINS=https://admin.example.com. The API is Bearer-token
# authenticated, never cookie-based, so credentials are never sent
# cross-origin regardless of this setting.
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Dedicated secret for signing customer access tokens (JWT, HS256). Must never
# reuse APP_KEY. Generate with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30

# BLUE V1 Phase A2.2 - Admin WebAuthn/MFA (config/admin_webauthn.php).
# rp_id/allowed_origins are security-critical and have NO default in ANY
# environment (local dev included) - unlike CORS_ALLOWED_ORIGINS below,
# which defaults permissively for convenience, WebAuthn origin/RP validation
# is a hard cryptographic security boundary, not a browser-relaxation
# concern. Every credential is permanently bound to the exact RP ID used at
# registration time, so set this deliberately, e.g.:
#   ADMIN_WEBAUTHN_RP_ID=admin.example.com
#   ADMIN_WEBAUTHN_ORIGINS=https://admin.example.com
# For local development against a browser, use the exact origin you browse
# to, e.g. ADMIN_WEBAUTHN_RP_ID=localhost / ADMIN_WEBAUTHN_ORIGINS=http://localhost:5173
ADMIN_WEBAUTHN_RP_NAME="BLUE Admin"
ADMIN_WEBAUTHN_RP_ID=
ADMIN_WEBAUTHN_ORIGINS=
ADMIN_WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# BLUE V1 Phase A2.4 - Admin session security (config/admin_session.php).
# ADMIN_WEB-only - Customer/mobile sessions are entirely unaffected and keep
# using AUTH_SESSION_TTL_DAYS above. An Admin session is deliberately much
# shorter-lived than a Customer one: session_ttl_hours is the absolute
# lifetime from MFA-issued login (never extended by refresh);
# idle_timeout_minutes revokes the session if no authenticated Admin API
# request occurs within this window (a token refresh alone never counts as
# activity); activity_touch_minutes throttles how often a genuine request
# is allowed to update the activity timestamp, so it is not written on
# every single request. See App\Support\Admin\AdminSessionPolicy.
AUTH_ADMIN_SESSION_TTL_HOURS=12
AUTH_ADMIN_IDLE_TIMEOUT_MINUTES=20
AUTH_ADMIN_ACTIVITY_TOUCH_MINUTES=5

# BLUE V1 Phase A2.5 - Admin WebAuthn step-up freshness window (also
# config/admin_session.php). Minutes a successful STEP_UP WebAuthn ceremony
# keeps the CURRENT session's sensitive-action gate (admin.stepup, e.g.
# contracts.cancel) open - reusable for several actions within this window,
# a fresh ceremony is required again once it lapses. Never extended by
# refresh and never satisfied by login MFA - see
# App\Support\Admin\AdminSessionPolicy. Always clamped to never exceed
# AUTH_ADMIN_IDLE_TIMEOUT_MINUTES above, regardless of what is set here.
AUTH_ADMIN_STEP_UP_TTL_MINUTES=5

# No SMS provider is integrated yet - see docs/api-contracts/authentication-v1.md.
# "null" (default) discards every generated OTP after hashing, exactly as
# before this setting existed - App\Providers\OtpDeliveryServiceProvider
# refuses to boot with "null" under APP_ENV=production, since a production
# deployment must actually deliver OTPs. "log" additionally writes the raw
# OTP to the log, but the same provider refuses to boot with "log" set
# outside APP_ENV=local - never set this to "log" here or in any non-local
# environment. "twilio" delivers via Twilio's Messages API - the approved
# BLUE V1 production driver; requires the TWILIO_* variables below.
OTP_DELIVERY_DRIVER=null

# Twilio (BLUE V1 production OTP delivery, OTP_DELIVERY_DRIVER=twilio only).
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are always required. Configure
# exactly one sender strategy: TWILIO_MESSAGING_SERVICE_SID (preferred, takes
# precedence if both are set) or TWILIO_FROM_NUMBER. Never commit real
# values here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_TIMEOUT_SECONDS=10

# Minutes an appointment hold stays usable before it expires. Approved BLUE
# V1 default - see docs/api-contracts/checkout-v1.md.
CHECKOUT_APPOINTMENT_HOLD_TTL_MINUTES=10

# BLUE V1 Phase 6A payment provider. Stripe is the only approved provider -
# see docs/api-contracts/payments-v1.md. Empty Stripe keys are valid before
# a Stripe account exists: config/services.php resolves an unconfigured
# StripePaymentGateway that fails safely (never fakes success) instead of
# calling the Stripe API. Never commit real keys here.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# BLUE V1 Phase 11 Service Contract Billing (Stripe Subscriptions) - a fully
# separate integration from the Booking PaymentIntent one above, see
# docs/api-contracts/contracts-v1.md "Stripe Billing". Reuses STRIPE_SECRET_KEY
# for API calls; STRIPE_CONTRACT_BILLING_WEBHOOK_SECRET is a DIFFERENT signing
# secret because it is a different Stripe webhook endpoint. The checkout
# success/cancel URLs are server-configured Flutter deep links/web pages the
# customer is redirected to after Stripe Checkout - never client-supplied.
# Never commit real values here.
CONTRACT_BILLING_PROVIDER=stripe
STRIPE_CONTRACT_BILLING_WEBHOOK_SECRET=
CONTRACT_BILLING_CHECKOUT_SUCCESS_URL=
CONTRACT_BILLING_CHECKOUT_CANCEL_URL=
CONTRACT_BILLING_GRACE_DAYS=3

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blue_db
DB_USERNAME=blue_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
