<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="OTP_DELIVERY_DRIVER" value="null" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="AUTH_JWT_SECRET" value="testing-only-auth-jwt-secret-not-a-real-secret"/>
        <env name="AUTH_ACCESS_TOKEN_TTL_MINUTES" value="15"/>
        <env name="AUTH_SESSION_TTL_DAYS" value="30"/>
        <env name="ADMIN_WEBAUTHN_RP_NAME" value="BLUE Admin (Testing)"/>
        <env name="ADMIN_WEBAUTHN_RP_ID" value="admin.blue.test"/>
        <env name="ADMIN_WEBAUTHN_ORIGINS" value="https://admin.blue.test"/>
        <env name="ADMIN_WEBAUTHN_CHALLENGE_TTL_SECONDS" value="300"/>
        <env name="AUTH_ADMIN_SESSION_TTL_HOURS" value="12"/>
        <env name="AUTH_ADMIN_IDLE_TIMEOUT_MINUTES" value="20"/>
        <env name="AUTH_ADMIN_ACTIVITY_TOUCH_MINUTES" value="5"/>
        <env name="AUTH_ADMIN_STEP_UP_TTL_MINUTES" value="5"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="blue_test_db"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
