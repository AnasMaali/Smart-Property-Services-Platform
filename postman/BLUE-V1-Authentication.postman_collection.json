            },
            "url": {
              "raw": "{{base_url}}/auth/verify-phone-number-change-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-phone-number-change-otp"]
            },
            "description": "Verifies the PHONE_NUMBER_CHANGE OTP and, only on success, updates users.phone_number. Revokes every other session for the user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
