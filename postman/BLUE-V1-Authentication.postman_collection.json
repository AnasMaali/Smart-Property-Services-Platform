{
  "info": {
    "_postman_id": "866e07d3-8642-46ee-89af-a8d715339990",
    "name": "BLUE V1 - Customer Authentication",
    "description": "BLUE V1 customer authentication endpoints, generated from the actual implementation in backend/routes/api.php, backend/app/Http/Controllers/Api/V1/Auth, backend/app/Actions/Auth, and verified against backend/tests/Feature/Auth. See docs/api-contracts/authentication-v1.md for the full written contract.\n\nNo SMS delivery integration exists yet, so OTP codes are never returned by any endpoint. BLUE stores only a one-way hash of each OTP (code_hash) - the raw code cannot be recovered from the database. Set otp_code manually in the environment after obtaining the raw OTP from the future SMS delivery / development delivery mechanism once implemented. Never add a debug endpoint or any other channel to expose OTP codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Registration",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Layla Hassan\",\n  \"phone_number\": \"{{phone_number}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"city_id\": 1,\n  \"area_id\": 1,\n  \"property_relationship_type_id\": 1,\n  \"service_interests\": [1, 2]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates the customer account (PENDING_VERIFICATION) and issues a PHONE_VERIFICATION OTP. Requires valid, active city_id/area_id/property_relationship_type_id/service_interests reference IDs seeded in the target environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "if (json.data && json.data.otp_verification_uuid) {",
                  "    pm.environment.set('otp_verification_uuid', json.data.otp_verification_uuid);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 - Phone Verification",
      "item": [
        {
          "name": "Verify Phone OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_verification_uuid\": \"{{otp_verification_uuid}}\",\n  \"otp_code\": \"{{otp_code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-phone",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-phone"]
            },
            "description": "Verifies the PHONE_VERIFICATION OTP issued by Register or Resend Phone OTP, and activates the account. Only a hash of the OTP is stored server-side, so the raw code cannot be read from the database; otp_code must be obtained from the future SMS delivery / development delivery mechanism, never from an API response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Resend Phone OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_verification_uuid\": \"{{otp_verification_uuid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-otp"]
            },
            "description": "Reissues a PHONE_VERIFICATION OTP, subject to a 60-second cooldown. The returned otp_verification_uuid replaces the previous one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "if (json.data && json.data.otp_verification_uuid) {",
                  "    pm.environment.set('otp_verification_uuid', json.data.otp_verification_uuid);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "03 - Login & Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"password\": \"{{password}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"Postman Test Device\",\n  \"app_version\": \"1.0.0\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates by phone_number + password and creates a new auth_sessions row. Requires an ACTIVE account with a verified phone number."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "if (json.data) {",
                  "    if (json.data.access_token) pm.environment.set('access_token', json.data.access_token);",
                  "    if (json.data.refresh_token) pm.environment.set('refresh_token', json.data.refresh_token);",
                  "    if (json.data.session_uuid) pm.environment.set('session_uuid', json.data.session_uuid);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates the refresh token and issues a new access token for the same session. The old refresh token becomes unusable immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "if (json.data) {",
                  "    if (json.data.access_token) pm.environment.set('access_token', json.data.access_token);",
                  "    if (json.data.refresh_token) pm.environment.set('refresh_token', json.data.refresh_token);",
                  "    if (json.data.session_uuid) pm.environment.set('session_uuid', json.data.session_uuid);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes only the current session identified by the Bearer access token's sid claim."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout All Sessions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout-all",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout-all"]
            },
            "description": "Revokes every auth_sessions row for the authenticated user, including the current session and all other devices."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "04 - Password Recovery",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Always returns 200 with the same generic message, whether or not the phone number belongs to an account (non-enumerating by design). No OTP UUID or code is ever returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verify Password Reset OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp_code\": \"{{otp_code}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-password-reset-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-password-reset-otp"]
            },
            "description": "Verifies the latest PASSWORD_RESET OTP for phone_number (looked up by phone number, not by UUID, since Forgot Password never returns one) and returns a one-time reset_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "if (json.data && json.data.reset_token) {",
                  "    pm.environment.set('reset_token', json.data.reset_token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"{{new_password}}\",\n  \"password_confirmation\": \"{{new_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Redeems reset_token to set a new password, then revokes every existing session for the user - the customer must log in again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "05 - Password Management",
      "item": [
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"new_password\": \"{{new_password}}\",\n  \"new_password_confirmation\": \"{{new_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Changes the authenticated customer's password. Keeps the current session valid and revokes every other session for the user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
